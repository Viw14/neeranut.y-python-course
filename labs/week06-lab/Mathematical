# เขียน function la calculate_sphere(radius):
# ค่านวณหา ปริมาตร ของทรงกลม
# volume = 4.0 / 3 =  pi = radius ** 3
# จากนั้นแสดงผลลัพธ์ที่เหมาะสมออกทางหน้าจอ

# ไม่ลืมที่จะเขียนโปรแกรมในส่วนของการทดสอบการใช้งาน

import math

def calculate_sphere(radius):
    volume = (4.0 / 3) * math.pi * (radius ** 3)
    print(f"Radius = {radius}")
    print(f"Volume = {volume:.2f}")
    print()

# ทดสอบการใช้งาน
print("Calculating sphere volumes:")
calculate_sphere(3)
calculate_sphere(5)